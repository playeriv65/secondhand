---
import { catalog, priceText, dateText } from "../lib/catalog.mjs";
import { isUpcoming } from "../lib/availability.mjs";
const { item, day, hidden } = Astro.props;
---

<article
  class="item"
  hidden={hidden}
  data-id={item.id}
  data-images={JSON.stringify(item.images)}
  data-available-from={item.availableFrom ?? ""}
>
  <div class="item-photo">
    <img src={item.images[0]} alt={item.name} loading="lazy" />
    {item.status === "sold" && <span class="item-sold">已售出</span>}
  </div>
  <div class="item-info">
    <div class="item-title-row">
      <h3>
        <button class="item-open" type="button" aria-haspopup="dialog">
          {item.name}
        </button>
      </h3>
      <span class="price">{priceText(item)}</span>
    </div>
    <p class="item-desc">{item.description}</p>
    {item.availableFrom && (
      <p class="item-date" data-date hidden={!isUpcoming(item, day)}>
        {catalog.labels.datePrefix}{" "}
        <time datetime={item.availableFrom}>
          {dateText(item.availableFrom)}
        </time>
      </p>
    )}
  </div>
</article>
