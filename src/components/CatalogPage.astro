---
import ItemCard from "./ItemCard.astro";
import ItemDetails from "./ItemDetails.astro";
import CatalogEditor from "./CatalogEditor.astro";
import { catalog } from "../lib/catalog.mjs";
import {
  localDay,
  itemsForPage,
  isUpcoming,
  listedItems,
} from "../lib/availability.mjs";
import "../styles/global.css";
const { later = false } = Astro.props;
const day = localDay(catalog.timeZone);
const title = later ? `${catalog.title} · 毕业后预计出` : catalog.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5ef" />
    <meta name="description" content={catalog.description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body
    data-page={later ? "later" : "now"}
    data-time-zone={catalog.timeZone}
    data-title={catalog.title}
  >
    <main>
      <section class="intro" aria-label="交易说明">
        <p class="pickup">{catalog.pickup}</p>
      </section>
      <nav class="pages" aria-label="出售时间">
        <a href="/" data-view="now" aria-current={!later ? "page" : undefined}>
          现在可出
        </a>
        <a
          href="/later.html"
          data-view="later"
          aria-current={later ? "page" : undefined}
        >
          毕业后预计出 <span>↗</span>
        </a>
      </nav>
      <p class="later-note" hidden={!later}>
        {catalog.laterDescription}
      </p>
      <section aria-label="我的闲置物品">
        <CatalogEditor />
        <div class="grid">
          {listedItems(catalog.items).map((item) => (
            <ItemCard
              item={item}
              day={day}
              hidden={isUpcoming(item, day) !== later}
            />
          ))}
        </div>
        <p
          id="empty"
          class="empty"
          hidden={itemsForPage(catalog.items, later, day).length > 0}
        >
          {catalog.labels.empty}
        </p>
      </section>
      <ItemDetails />
    </main>
    <script>
      import "../scripts/availability.mjs";
    </script>
  </body>
</html>
